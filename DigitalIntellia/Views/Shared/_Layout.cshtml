<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="FdV8UlKCpoadqy9KRdl1xD94iFWQ7pcfTrJzGE6jhaQ" />
    <link rel="icon" type="image/png" href="/Images/favicon.png?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] | Digital Intellia</title>

    <meta name="description" content="Explore website design, business dashboards, data analytics and custom digital solutions by Digital Intellia. Helping businesses build a smarter digital presence." />
    <link rel="canonical" href="https://digitalintellia.onrender.com/" />
    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Digital Intellia" />
    <meta property="og:title" content="Digital Intellia | Building Smarter Digital Solutions" />
    <meta property="og:description" content="Professional website design, business dashboards, data analytics and custom digital solutions for businesses across South Africa." />
    <meta property="og:url" content="https://digitalintellia.onrender.com/" />
    <meta property="og:image" content="https://digitalintellia.onrender.com/Images/Logo-removebg-preview.png" />
    <meta property="og:locale" content="en_ZA" />

    <!-- Twitter / X Sharing -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Digital Intellia | Building Smarter Digital Solutions" />
    <meta name="twitter:description" content="Professional website design, business dashboards, data analytics and custom digital solutions across South Africa." />
    <meta name="twitter:image" content="https://digitalintellia.onrender.com/Images/Logo-removebg-preview.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Structured Data: Digital Intellia -->
    <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@graph": [
            {
              "@type": "Organization",
              "@id": "https://digitalintellia.onrender.com/#organization",
              "name": "Digital Intellia",
              "url": "https://digitalintellia.onrender.com/",
              "logo": "https://digitalintellia.onrender.com/Images/Logo-removebg-preview.png",
              "description": "A South African digital solutions brand providing website design, business dashboards, data analytics and custom technology solutions.",
              "email": "digitalintellia@gmail.com",
              "telephone": "+27729058765",
              "areaServed": {
                "@type": "Country",
                "name": "South Africa"
              },
              "knowsAbout": [
                "Website Design",
                "Dashboard Design",
                "Data Analytics",
                "Business Intelligence",
                "SQL and Database Solutions",
                "Custom Digital Solutions"
              ]
            },
            {
              "@type": "WebSite",
              "@id": "https://digitalintellia.onrender.com/#website",
              "url": "https://digitalintellia.onrender.com/",
              "name": "Digital Intellia",
              "publisher": {
                "@id": "https://digitalintellia.onrender.com/#organization"
              },
              "inLanguage": "en-ZA"
            }
          ]
        }
    </script>

</head>

<body>

    <div class="announcement-bar">
        <span class="announcement-dot"></span>
        Building smarter digital experiences
        <span class="announcement-divider">✦</span>
        <span>Let's build something great.</span>
    </div>

    <header class="site-header">
        <div class="nav-container">

            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-symbol">
                    <img src="~/Images/Logo-removebg-preview.png" alt="Digital Intellia Logo" />
                </span>
                <span class="brand-name">
                    DIGITAL<span>INTELLIA</span>
                    <small>BUILDING SMARTER DIGITAL SOLUTIONS</small>
                </span>
            </a>

            <button class="menu-toggle"
                    aria-label="Open navigation"
                    aria-expanded="false">
                <span></span>
                <span></span>
            </button>

            <nav class="site-nav">
                <a href="#home" class="nav-link active">Home</a>
                <a href="#about" class="nav-link">About</a>
                <a href="#services" class="nav-link">Services</a>
                <a href="#work" class="nav-link">Our Work</a>

                <a href="#contact" class="nav-contact">
                    Let's Talk
                    <span>↗</span>
                </a>
            </nav>

        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">

        <div class="footer-main">

            <div class="footer-brand">
                <a class="brand footer-logo" href="#home">
                    <span class="brand-symbol">
                        <img src="~/Images/Logo-removebg-preview.png" alt="Digital Intellia Logo" />
                    </span>
                    <span class="brand-name">
                        DIGITAL<span>INTELLIA</span>
                        <small>BUILDING SMARTER DIGITAL SOLUTIONS</small>
                    </span>
                </a>

                <p>
                    Thoughtful design. Smart technology.
                    Digital experiences that move businesses forward.
                </p>
            </div>

            <div class="footer-column">
                <h4>Explore</h4>
                <a href="#home">Home</a>
                <a href="#services">Services</a>
                <a href="#work">Our Work</a>
                <a href="#about">About Us</a>
            </div>

            <div class="footer-column">
                <h4>Get in touch</h4>
                <a href="mailto:digitalintellia@gmail.com">
                    digitalintellia@gmail.com
                </a>
                <a href="#contact">Start a project ↗</a>
            </div>

        </div>

        <div class="footer-bottom">
            <span>© @DateTime.Now.Year Digital Intellia. All rights reserved.</span>
            <span>Designed with intention. Built with intelligence.</span>
        </div>

    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>